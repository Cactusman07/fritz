{
  "name": "fritzs-wieners-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Theme build tooling for Fritz's Wieners",
  "scripts": {
    "clean": "rimraf build dist",
    "build:css": "sass src/scss/bundle.scss build/theme/styles/bundle.css --style=expanded --no-source-map",
    "build:js": "esbuild src/js/app.js --bundle --platform=browser --format=iife --sourcemap --outfile=build/theme/js/bundle.js",
    "copy:theme": "node scripts/copy-theme.mjs",
    "build": "npm run clean && npm run build:css && npm run build:js && npm run copy:theme && node scripts/package-theme.mjs"
  },
  "author": "Sam Muir",
  "license": "ISC",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.5",
    "rimraf": "^6.0.0",
    "sass": "^1.89.2"
  },
  "dependencies": {
    "jquery": "^3.5.1",
    "jquery-match-height": "^0.7.2"
  }
}
